<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
             x:Class="GitWerka.App"
             RequestedThemeVariant="Dark">

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://GitWerka/Src/Shared/GlobalStyles/Colors.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <materialIcons:MaterialIconStyles />
    <StyleInclude Source="avares://GitWerka/Src/Shared/GlobalStyles/ButtonsStyles.axaml" />
    <StyleInclude Source="avares://GitWerka/Src/Shared/GlobalStyles/TextBlocksStyles.axaml" />
    <StyleInclude Source="avares://GitWerka/Src/Shared/GlobalStyles/TextBoxStyles.axaml" />
  </Application.Styles>
</Application>
<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:host="using:GitWerka.Features.Shell.UI.Screens.Host"
        xmlns:sharedRes="using:GitWerka.Shared.Resources"
        xmlns:local="using:GitWerka"
        mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
        x:Class="GitWerka.MainWindow"
        x:DataType="local:MainWindowViewModel"
        Title="{x:Static sharedRes:GlobalStrings.AppTitle}"
        Width="1120"
        Height="720"
        MinWidth="800"
        MinHeight="550"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource AppBackgroundBrush}">

  <host:HostView x:Name="HostViewControl" />

</Window>

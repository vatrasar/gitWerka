<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Conflict Badges -->
  <Style Selector="Border.ConflictBadgeA">
    <Setter Property="Background" Value="{DynamicResource ConflictOursBadgeBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,2" />
  </Style>

  <Style Selector="Border.ConflictBadgeB">
    <Setter Property="Background" Value="{DynamicResource ConflictTheirsBadgeBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,2" />
  </Style>

  <Style Selector="Border.ConflictBadgeOutput">
    <Setter Property="Background" Value="{DynamicResource ConflictOutputBadgeBrush}" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Padding" Value="6,2" />
  </Style>

  <!-- Line Numbers -->
  <Style Selector="TextBlock.ConflictLineNumber">
    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFamily" Value="Consolas, Menlo, Cascadia Code, DejaVu Sans Mono, monospace" />
    <Setter Property="TextAlignment" Value="Right" />
    <Setter Property="Width" Value="36" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0,0,8,0" />
  </Style>

  <!-- Monospace Code Text -->
  <Style Selector="TextBlock.ConflictCodeText">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontFamily" Value="Consolas, Menlo, Cascadia Code, DejaVu Sans Mono, monospace" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- Conflict Highlight Rows -->
  <Style Selector="Border.ConflictRowOurs">
    <Setter Property="Background" Value="{DynamicResource ConflictOursBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConflictOursForegroundColor}" />
  </Style>

  <Style Selector="Border.ConflictRowTheirs">
    <Setter Property="Background" Value="{DynamicResource ConflictTheirsBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConflictTheirsForegroundColor}" />
  </Style>

  <Style Selector="Border.ConflictRowOutput">
    <Setter Property="Background" Value="{DynamicResource ConflictOutputBackgroundBrush}" />
    <Setter Property="BorderThickness" Value="2,0,0,0" />
    <Setter Property="BorderBrush" Value="{DynamicResource ConflictOutputForegroundColor}" />
  </Style>

  <Style Selector="Border.NormalRow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <!-- Panel Header Container -->
  <Style Selector="Border.ConflictPanelHeader">
    <Setter Property="Background" Value="{DynamicResource ShellHeaderFooterBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

</Styles>

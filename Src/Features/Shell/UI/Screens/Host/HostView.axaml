<rxui:ReactiveUserControl x:TypeArguments="vm:HostViewModel"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:res="using:GitWerka.Features.Shell.Resources"
                          xmlns:vm="using:GitWerka.Features.Shell.UI.Screens.Host"
                          xmlns:material="using:Material.Icons.Avalonia"
                          x:Class="GitWerka.Features.Shell.UI.Screens.Host.HostView">

  <UserControl.Styles>
    <StyleInclude Source="avares://GitWerka/Src/Features/Shell/UI/Screens/Host/ScreenStyles/HostStyles.axaml" />
  </UserControl.Styles>

  <Grid RowDefinitions="Auto, *, Auto">
    <!-- Top Shell Navigation Bar -->
    <Border Grid.Row="0" Classes="ShellHeader">
      <Grid ColumnDefinitions="Auto, *, Auto">
        <!-- Back Navigation & Branding -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button x:Name="BackButton"
                  Classes="IconButton"
                  ToolTip.Tip="{x:Static res:ShellStrings.BackButton}"
                  IsVisible="False">
            <material:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" />
          </Button>

          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <material:MaterialIcon Kind="Git" Width="22" Height="22" Foreground="{DynamicResource GitGraphBranch1Brush}" />
            <TextBlock Text="{x:Static res:ShellStrings.ShellWindowTitle}"
                       FontWeight="SemiBold"
                       FontSize="15"
                       VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <!-- Current Active Repository Title -->
        <StackPanel Grid.Column="1"
                    x:Name="ActiveRepositoryHeaderPanel"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="False">
          <material:MaterialIcon Kind="SourceRepository" Width="18" Height="18" Foreground="{DynamicResource GitGraphBranch2Brush}" />
          <TextBlock x:Name="ActiveRepositoryNameTextBlock"
                     FontWeight="SemiBold"
                     FontSize="14"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Right Window Actions (Settings) -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button x:Name="SettingsButton"
                  Classes="IconButton"
                  ToolTip.Tip="{x:Static res:ShellStrings.SettingsButton}"
                  IsVisible="False">
            <material:MaterialIcon Kind="Cog" Width="20" Height="20" />
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Center Routed Content Host -->
    <rxui:RoutedViewHost Grid.Row="1"
                         x:Name="RoutedViewHostControl"
                         HorizontalContentAlignment="Stretch"
                         VerticalContentAlignment="Stretch" />

    <!-- Bottom Status Bar -->
    <Border Grid.Row="2" Classes="ShellFooter">
      <Grid ColumnDefinitions="Auto, *, Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <material:MaterialIcon Kind="CheckCircleOutline" Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}" />
          <TextBlock x:Name="StatusMessageTextBlock"
                     Classes="SubtleCaption"
                     VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Column="2"
                   Text="v1.0.0"
                   Classes="SubtleCaption"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>
  </Grid>
</rxui:ReactiveUserControl>

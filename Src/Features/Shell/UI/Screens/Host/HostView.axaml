<rxui:ReactiveUserControl x:TypeArguments="vm:HostViewModel"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:res="using:GitWerka.Features.Shell.Resources"
                          xmlns:vm="using:GitWerka.Features.Shell.UI.Screens.Host"
                          xmlns:models="using:GitWerka.Core.Domain.Models"
                          xmlns:material="using:Material.Icons.Avalonia"
                          x:Class="GitWerka.Features.Shell.UI.Screens.Host.HostView">

  <UserControl.Styles>
    <StyleInclude Source="avares://GitWerka/Src/Features/Shell/UI/Screens/Host/ScreenStyles/HostStyles.axaml" />
  </UserControl.Styles>

  <Grid RowDefinitions="Auto, *, Auto">
    <!-- Top Shell Navigation Bar -->
    <Border Grid.Row="0" Classes="ShellHeader">
      <Grid ColumnDefinitions="Auto, *, Auto">
        <!-- Back Navigation & Branding -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button x:Name="BackButton"
                  Classes="IconButton"
                  ToolTip.Tip="{x:Static res:ShellStrings.BackButton}"
                  IsVisible="False">
            <material:MaterialIcon Kind="ArrowLeft" Width="20" Height="20" />
          </Button>

          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <material:MaterialIcon Kind="Git" Width="22" Height="22" Foreground="{DynamicResource GitGraphBranch1Brush}" />
            <TextBlock Text="{x:Static res:ShellStrings.ShellWindowTitle}"
                       FontWeight="SemiBold"
                       FontSize="15"
                       VerticalAlignment="Center" />
          </StackPanel>
        </StackPanel>

        <!-- Current Active Repository Title -->
        <StackPanel Grid.Column="1"
                    x:Name="ActiveRepositoryHeaderPanel"
                    Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsVisible="False">
          <material:MaterialIcon Kind="SourceRepository" Width="18" Height="18" Foreground="{DynamicResource GitGraphBranch2Brush}" />
          <TextBlock x:Name="ActiveRepositoryNameTextBlock"
                     FontWeight="SemiBold"
                     FontSize="14"
                     VerticalAlignment="Center" />
        </StackPanel>

        <!-- Right Window Actions (Settings, Profiles) -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button x:Name="SettingsButton"
                  Classes="IconButton"
                  ToolTip.Tip="{x:Static res:ShellStrings.SettingsButton}"
                  IsVisible="False">
            <material:MaterialIcon Kind="Cog" Width="20" Height="20" />
          </Button>

          <!-- Profile Selector & Management Dropdown Button to the right of Settings -->
          <Button x:Name="ProfileMenuButton"
                  Classes="ShellProfileButton"
                  ToolTip.Tip="{x:Static res:ShellStrings.ProfilesTooltip}"
                  IsVisible="False">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <material:MaterialIcon Kind="AccountCircleOutline" Width="16" Height="16" Foreground="{DynamicResource AccentPrimaryBrush}" />
              <TextBlock x:Name="ActiveProfileNameTextBlock"
                         Text="{x:Static res:ShellStrings.NoActiveProfile}"
                         MaxWidth="130"
                         TextTrimming="CharacterEllipsis"
                         VerticalAlignment="Center"
                         FontSize="12" />
              <material:MaterialIcon Kind="ChevronDown" Width="12" Height="12" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedRight">
                <Border MinWidth="240"
                        Padding="8"
                        Background="{DynamicResource SurfaceCardBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{x:Static res:ShellStrings.ProfilesMenuTitle}"
                               FontWeight="SemiBold"
                               FontSize="11"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Margin="4,2,4,2" />

                    <TextBlock x:Name="NoProfilesFlyoutTextBlock"
                               Text="{x:Static res:ShellStrings.NoProfilesCreatedYet}"
                               FontSize="12"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Margin="6,4"
                               IsVisible="False" />

                    <ListBox x:Name="ProfilesFlyoutListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             MaxHeight="200">
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="models:GitProfile">
                          <Grid ColumnDefinitions="Auto, *">
                            <material:MaterialIcon Grid.Column="0"
                                                   Kind="AccountOutline"
                                                   Width="14"
                                                   Height="14"
                                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                                   Margin="0,0,6,0" />
                            <StackPanel Grid.Column="1" Spacing="1">
                              <TextBlock Text="{Binding Name}"
                                         FontWeight="SemiBold"
                                         FontSize="12"
                                         Foreground="{DynamicResource TextPrimaryBrush}" />
                              <TextBlock Text="{Binding Author.Name}"
                                         FontSize="10"
                                         Foreground="{DynamicResource SubtleTextBrush}" />
                            </StackPanel>
                          </Grid>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>

                    <Rectangle Height="1" Fill="{DynamicResource CardBorderBrush}" Margin="0,4" />

                    <Button x:Name="ManageProfilesButton"
                            Classes="MenuAction"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left">
                      <StackPanel Orientation="Horizontal" Spacing="8">
                        <material:MaterialIcon Kind="AccountCogOutline" Width="15" Height="15" Foreground="{DynamicResource AccentPrimaryBrush}" />
                        <TextBlock Text="{x:Static res:ShellStrings.ManageProfilesButton}" FontWeight="Medium" />
                      </StackPanel>
                    </Button>
                  </StackPanel>
                </Border>
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Center Routed Content Host -->
    <rxui:RoutedViewHost Grid.Row="1"
                         x:Name="RoutedViewHostControl"
                         HorizontalContentAlignment="Stretch"
                         VerticalContentAlignment="Stretch" />

    <!-- Bottom Status Bar -->
    <Border Grid.Row="2" Classes="ShellFooter">
      <Grid ColumnDefinitions="Auto, *, Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <material:MaterialIcon Kind="CheckCircleOutline" Width="16" Height="16" Foreground="{DynamicResource SuccessBrush}" />
          <TextBlock x:Name="StatusMessageTextBlock"
                     Classes="SubtleCaption"
                     VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock x:Name="FooterInfoTextBlock"
                   Grid.Column="2"
                   Classes="SubtleCaption"
                   VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis"
                   MaxWidth="600" />
      </Grid>
    </Border>
  </Grid>
</rxui:ReactiveUserControl>

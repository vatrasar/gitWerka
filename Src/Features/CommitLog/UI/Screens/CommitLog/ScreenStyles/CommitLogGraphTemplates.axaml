<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="using:GitWerka.Core.Domain.Models"
                    xmlns:enums="using:GitWerka.Core.Domain.Enums"
                    xmlns:conv="using:GitWerka.Shared.Converters"
                    xmlns:material="using:Material.Icons.Avalonia"
                    xmlns:canvas="using:GitWerka.Features.CommitLog.UI.Screens.CommitLog.ScreenComponents.CommitGraphCanvas"
                    xmlns:titlePanel="using:GitWerka.Features.CommitLog.UI.Screens.CommitLog.ScreenComponents.CommitTitlePanel">

  <!-- Commit Graph List Item Template -->
  <DataTemplate x:Key="CommitListItemTemplate" x:DataType="models:CommitSummary">
    <Grid MinHeight="28">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="70" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="140" />
        <ColumnDefinition Width="110" />
      </Grid.ColumnDefinitions>

      <!-- Visual Graph Lane Canvas -->
      <canvas:CommitGraphCanvas Grid.Column="0"
                               x:Name="CommitLaneCanvas"
                               GraphWidth="{Binding GraphWidth}"
                               Lane="{Binding Lane}"
                               IsWip="{Binding IsWip}"
                               IsHead="{Binding IsHead}"
                               PassingLanes="{Binding PassingLanes}"
                               MergingLanes="{Binding MergingLanes}"
                               ForkingOffLanes="{Binding ForkingOffLanes}" />

      <!-- Commit Short SHA -->
      <TextBlock Grid.Column="1"
                 x:Name="CommitShortShaTextBlock"
                 Text="{Binding ShortSha}"
                 Classes="Monospace"
                 Foreground="{DynamicResource GitGraphBranch1Brush}"
                 VerticalAlignment="Center" />

      <!-- Commit Message and Branch/Tag Badges -->
      <titlePanel:CommitTitlePanel Grid.Column="2"
                                  x:Name="CommitMessageTitlePanel"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0">
        <!-- Badges Container -->
        <WrapPanel x:Name="CommitBadgesWrapPanel"
                   Orientation="Horizontal"
                   VerticalAlignment="Center"
                   IsVisible="{Binding HasBadges}">
          <!-- WIP Indicator and Uncommitted Count -->
          <Border x:Name="WipIndicatorBadge" Classes="WipBadge" IsVisible="{Binding IsWip}">
            <TextBlock x:Name="WipBadgeTextBlock" Text="// WIP" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentPrimaryBrush}" />
          </Border>
          <StackPanel x:Name="WipCountStackPanel" Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsWip}" VerticalAlignment="Center" Margin="0,0,6,0">
            <material:MaterialIcon Kind="Pencil" Width="13" Height="13" Foreground="{DynamicResource GitGraphBranch3Brush}" VerticalAlignment="Center" />
            <TextBlock x:Name="WipFilesCountTextBlock" Text="{Binding UncommittedFilesCount}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- HEAD Indicator Badge -->
          <Border x:Name="HeadIndicatorBadge"
                  Classes="HeadBadge"
                  IsVisible="{Binding IsHead}"
                  ToolTip.Tip="{Binding HeadToolTip}">
            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
              <material:MaterialIcon Kind="CompassOutline"
                                    Width="12"
                                    Height="12"
                                    Foreground="{DynamicResource GitGraphBranch2Brush}"
                                    VerticalAlignment="Center" />
              <TextBlock x:Name="HeadBadgeTextBlock"
                         Text="{Binding HeadLabel}"
                         FontSize="10"
                         FontWeight="Bold"
                         Foreground="{DynamicResource GitGraphBranch2Brush}"
                         VerticalAlignment="Center" />
            </StackPanel>
          </Border>

          <ItemsControl x:Name="CommitBranchesItemsControl" ItemsSource="{Binding BranchNames}" IsVisible="{Binding HasBranches}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="BranchBadge">
                  <TextBlock Text="{Binding}" FontSize="10" Foreground="White" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <ItemsControl x:Name="CommitTagsItemsControl" ItemsSource="{Binding TagNames}" IsVisible="{Binding HasTags}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Classes="TagBadge">
                  <TextBlock Text="{Binding}" FontSize="10" Foreground="White" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </WrapPanel>

        <!-- Commit Short Message -->
        <TextBlock x:Name="CommitMessageTextBlock"
                   Text="{Binding MessageShort}"
                   IsVisible="{Binding !IsWip}"
                   FontSize="13"
                   TextWrapping="Wrap"
                   VerticalAlignment="Center" />
      </titlePanel:CommitTitlePanel>

      <!-- Author Name -->
      <TextBlock Grid.Column="3"
                 x:Name="CommitAuthorTextBlock"
                 Text="{Binding AuthorName}"
                 Classes="SubtleCaption"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />

      <!-- Date -->
      <TextBlock Grid.Column="4"
                 x:Name="CommitDateTextBlock"
                 IsVisible="{Binding !IsWip}"
                 Text="{Binding AuthorDate, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}"
                 Classes="SubtleCaption"
                 VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

  <!-- Changed File Item Template -->
  <DataTemplate x:Key="ChangedFileItemTemplate" x:DataType="models:FileDiffSummary">
    <Border Classes="ChangedFileCard"
            ToolTip.Tip="{Binding Path}">
      <Grid ColumnDefinitions="Auto, *, Auto">
        <material:MaterialIcon Grid.Column="0"
                              Kind="{Binding Status, Converter={x:Static conv:FileStatusToIconConverter.Instance}}"
                              Foreground="{Binding Status, Converter={x:Static conv:FileStatusToBrushConverter.Instance}}"
                              Width="14"
                              Height="14"
                              Margin="0,0,6,0"
                              VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
                   Text="{Binding Path}"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="{Binding LinesAdded, StringFormat='+{0}'}"
                     Foreground="{DynamicResource SuccessBrush}"
                     FontSize="11" />
          <TextBlock Text="{Binding LinesDeleted, StringFormat='-{0}'}"
                     Foreground="{DynamicResource ErrorBrush}"
                     FontSize="11" />
        </StackPanel>
      </Grid>
    </Border>
  </DataTemplate>

  <!-- Diff Line Item Template -->
  <DataTemplate x:Key="DiffLineItemTemplate" x:DataType="models:DiffLine">
    <Grid ColumnDefinitions="45, 45, *">
      <TextBlock Grid.Column="0"
                 Text="{Binding OldLineNumber}"
                 Classes="Monospace SubtleCaption"
                 TextAlignment="Right"
                 Margin="0,0,6,0" />
      <TextBlock Grid.Column="1"
                 Text="{Binding NewLineNumber}"
                 Classes="Monospace SubtleCaption"
                 TextAlignment="Right"
                 Margin="0,0,8,0" />

      <TextBlock Grid.Column="2"
                 Text="{Binding Content}"
                 Classes="DiffAddition"
                 IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:DiffLineType.Addition}}" />
      <TextBlock Grid.Column="2"
                 Text="{Binding Content}"
                 Classes="DiffDeletion"
                 IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:DiffLineType.Deletion}}" />
      <TextBlock Grid.Column="2"
                 Text="{Binding Content}"
                 Classes="DiffHunkHeader"
                 IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:DiffLineType.HunkHeader}}" />
      <TextBlock Grid.Column="2"
                 Text="{Binding Content}"
                 Classes="DiffContext"
                 IsVisible="{Binding Type, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static enums:DiffLineType.Context}}" />
    </Grid>
  </DataTemplate>

  <!-- Rebase Step Item Template -->
  <DataTemplate x:Key="RebaseStepItemTemplate" x:DataType="models:RebaseStep">
    <Grid ColumnDefinitions="75, 75, *, 120" Height="28">
      <Border Grid.Column="0"
              Classes="BranchBadge"
              Margin="0,2,6,2"
              HorizontalAlignment="Left"
              VerticalAlignment="Center">
        <TextBlock Text="{Binding Action}"
                   FontSize="11"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
      </Border>

      <TextBlock Grid.Column="1"
                 Text="{Binding ShortSha}"
                 Classes="Monospace"
                 Foreground="{DynamicResource GitGraphBranch1Brush}"
                 VerticalAlignment="Center" />

      <TextBlock Grid.Column="2"
                 Text="{Binding NewMessage}"
                 FontSize="12"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />

      <TextBlock Grid.Column="3"
                 Text="{Binding AuthorName}"
                 Classes="SubtleCaption"
                 TextTrimming="CharacterEllipsis"
                 VerticalAlignment="Center" />
    </Grid>
  </DataTemplate>

</ResourceDictionary>

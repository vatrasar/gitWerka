<rxui:ReactiveUserControl x:TypeArguments="vm:RepositoryManagerViewModel"
                          xmlns="https://github.com/avaloniaui"
                          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                          xmlns:rxui="http://reactiveui.net"
                          xmlns:res="using:GitWerka.Features.RepositoryManager.Resources"
                          xmlns:sharedRes="using:GitWerka.Shared.Resources"
                          xmlns:vm="using:GitWerka.Features.RepositoryManager.UI.Screens.RepositoryManager"
                          xmlns:models="using:GitWerka.Core.Domain.Models"
                          xmlns:material="using:Material.Icons.Avalonia"
                          x:Class="GitWerka.Features.RepositoryManager.UI.Screens.RepositoryManager.RepositoryManagerView">

  <UserControl.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://GitWerka/Src/Features/RepositoryManager/UI/Screens/RepositoryManager/ScreenStyles/RepositoryManagerTemplates.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </UserControl.Resources>

  <UserControl.Styles>
    <StyleInclude Source="avares://GitWerka/Src/Features/RepositoryManager/UI/Screens/RepositoryManager/ScreenStyles/RepositoryManagerStyles.axaml" />
  </UserControl.Styles>

  <Grid x:Name="RootLayoutGrid">
    <!-- Main Two-Column Content -->
    <Grid Margin="32">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="360" />
        <ColumnDefinition Width="32" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>

      <!-- Left Column: Branding and Action Tiles -->
      <StackPanel Grid.Column="0" Spacing="16">
        <!-- Logo and App Title -->
        <StackPanel Spacing="6" Margin="0,0,0,12">
          <StackPanel Orientation="Horizontal" Spacing="12">
            <material:MaterialIcon Kind="Git" Width="36" Height="36" Foreground="{DynamicResource GitGraphBranch1Brush}" />
            <TextBlock Text="{x:Static res:RepositoryManagerStrings.WelcomeTitle}"
                       Classes="PageTitle"
                       VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="{x:Static res:RepositoryManagerStrings.WelcomeSubtitle}"
                     Classes="SubtleCaption" />
        </StackPanel>

        <!-- Error Notification Banner -->
        <Border x:Name="ErrorBannerBorder"
                Classes="ErrorBanner"
                IsVisible="False">
          <DockPanel LastChildFill="True">
            <Button x:Name="DismissErrorButton"
                    DockPanel.Dock="Right"
                    Classes="IconButton"
                    VerticalAlignment="Center">
              <material:MaterialIcon Kind="Close" Width="16" Height="16" Foreground="{DynamicResource OnErrorBrush}" />
            </Button>
            <TextBlock x:Name="ErrorBannerTextBlock"
                       Foreground="{DynamicResource OnErrorBrush}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center" />
          </DockPanel>
        </Border>

        <!-- Action Tile: Open Repository -->
        <Button x:Name="OpenRepositoryTileButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="0"
                Background="Transparent"
                BorderThickness="0">
          <Border Classes="ActionTile">
            <Grid ColumnDefinitions="Auto, *">
              <material:MaterialIcon Grid.Column="0"
                                    Kind="FolderOpen"
                                    Width="26"
                                    Height="26"
                                    Foreground="{DynamicResource GitGraphBranch1Brush}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{x:Static res:RepositoryManagerStrings.OpenRepositoryButton}"
                           Classes="SectionHeader" />
                <TextBlock Text="{x:Static res:RepositoryManagerStrings.OpenRepositoryDescription}"
                           Classes="SubtleCaption"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
        </Button>

        <!-- Action Tile: Clone Repository -->
        <Button x:Name="CloneRepositoryTileButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="0"
                Background="Transparent"
                BorderThickness="0">
          <Border Classes="ActionTile">
            <Grid ColumnDefinitions="Auto, *">
              <material:MaterialIcon Grid.Column="0"
                                    Kind="Download"
                                    Width="26"
                                    Height="26"
                                    Foreground="{DynamicResource GitGraphBranch2Brush}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{x:Static res:RepositoryManagerStrings.CloneRepositoryButton}"
                           Classes="SectionHeader" />
                <TextBlock Text="{x:Static res:RepositoryManagerStrings.CloneRepositoryDescription}"
                           Classes="SubtleCaption"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
        </Button>

        <!-- Action Tile: Create Local Repository -->
        <Button x:Name="InitRepositoryTileButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="0"
                Background="Transparent"
                BorderThickness="0">
          <Border Classes="ActionTile">
            <Grid ColumnDefinitions="Auto, *">
              <material:MaterialIcon Grid.Column="0"
                                    Kind="PlusBoxOutline"
                                    Width="26"
                                    Height="26"
                                    Foreground="{DynamicResource GitGraphBranch5Brush}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{x:Static res:RepositoryManagerStrings.InitRepositoryButton}"
                           Classes="SectionHeader" />
                <TextBlock Text="{x:Static res:RepositoryManagerStrings.InitRepositoryDescription}"
                           Classes="SubtleCaption"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
        </Button>

        <!-- Action Tile: Settings -->
        <Button x:Name="SettingsTileButton"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Padding="0"
                Background="Transparent"
                BorderThickness="0">
          <Border Classes="ActionTile">
            <Grid ColumnDefinitions="Auto, *">
              <material:MaterialIcon Grid.Column="0"
                                    Kind="CogOutline"
                                    Width="26"
                                    Height="26"
                                    Foreground="{DynamicResource AccentPrimaryBrush}"
                                    VerticalAlignment="Center"
                                    Margin="0,0,14,0" />
              <StackPanel Grid.Column="1" Spacing="2">
                <TextBlock Text="{x:Static res:RepositoryManagerStrings.SettingsButton}"
                           Classes="SectionHeader" />
                <TextBlock Text="{x:Static res:RepositoryManagerStrings.SettingsDescription}"
                           Classes="SubtleCaption"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </Border>
        </Button>
      </StackPanel>

      <!-- Right Column: Recent Repositories Section -->
      <Grid Grid.Column="2" RowDefinitions="Auto, 16, *">
        <!-- Tabs and Search Header -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *, 240">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
            <Button x:Name="FavoritesTabButton"
                    Classes="RepoManagerTab active">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <material:MaterialIcon Kind="Star" Width="16" Height="16" Foreground="{DynamicResource WarningBrush}" />
                <TextBlock Text="{x:Static res:RepositoryManagerStrings.FavoritesTabTitle}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <Button x:Name="RecentTabButton"
                    Classes="RepoManagerTab">
              <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <material:MaterialIcon Kind="History" Width="16" Height="16" />
                <TextBlock Text="{x:Static res:RepositoryManagerStrings.RecentTabTitle}" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>

          <TextBox Grid.Column="2"
                   x:Name="SearchInputTextBox"
                   Classes="SearchInput"
                   Watermark="{x:Static res:RepositoryManagerStrings.SearchRecentPlaceholder}" />
        </Grid>

        <!-- Loading Indicator -->
        <ProgressBar Grid.Row="2"
                     x:Name="LoadingProgressBar"
                     IsIndeterminate="True"
                     VerticalAlignment="Top"
                     IsVisible="False" />

        <!-- Recent Repositories ListBox -->
        <ListBox Grid.Row="2"
                 x:Name="RecentRepositoriesListBox"
                 Background="Transparent"
                 BorderThickness="0"
                 ItemTemplate="{StaticResource RecentRepoItemTemplate}" />

        <!-- Favorites View (Grouped & Ungrouped) -->
        <ScrollViewer Grid.Row="2"
                      x:Name="FavoritesScrollViewer"
                      Classes="FavoritesScrollViewer"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      IsVisible="False">
          <StackPanel x:Name="FavoritesContainerPanel" Spacing="8" Margin="0,0,0,16">
            <!-- Favorite Groups ItemsControl -->
            <ItemsControl x:Name="FavoriteGroupsItemsControl"
                          ItemTemplate="{StaticResource FavoriteGroupItemTemplate}" />

            <!-- Ungrouped Section Header -->
            <TextBlock x:Name="UngroupedFavoritesSectionHeaderTextBlock"
                       Text="{x:Static res:RepositoryManagerStrings.UngroupedFavoritesSectionHeader}"
                       Classes="SubtleCaption"
                       FontWeight="SemiBold"
                       FontSize="12"
                       Margin="4,4,0,2"
                       IsVisible="False" />

            <!-- Ungrouped Favorites ItemsControl -->
            <ItemsControl x:Name="UngroupedFavoritesItemsControl"
                          ItemTemplate="{StaticResource UngroupedFavoriteItemTemplate}" />
          </StackPanel>
        </ScrollViewer>

        <!-- Empty State Message -->
        <TextBlock Grid.Row="2"
                   x:Name="EmptyRepositoriesTextBlock"
                   Text="{x:Static res:RepositoryManagerStrings.NoRecentRepositories}"
                   Classes="SubtleCaption"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsVisible="False" />
      </Grid>
    </Grid>

    <!-- Modal Dialog Overlay: Clone -->
    <Border x:Name="CloneModalOverlay"
            Background="{DynamicResource ModalOverlayBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsVisible="False">
      <Border Classes="ModalDialogCard"
              Width="520"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{x:Static res:RepositoryManagerStrings.CloneModalTitle}"
                     Classes="SectionHeader" />

          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static res:RepositoryManagerStrings.RemoteUrlLabel}"
                       Classes="SubtleCaption" />
            <TextBox x:Name="CloneSourceUrlTextBox"
                     Watermark="{x:Static res:RepositoryManagerStrings.RemoteUrlPlaceholder}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static res:RepositoryManagerStrings.TargetDirectoryLabel}"
                       Classes="SubtleCaption" />
            <Grid ColumnDefinitions="*, 8, Auto">
              <TextBox Grid.Column="0"
                       x:Name="CloneTargetDirectoryTextBox" />
              <Button Grid.Column="2"
                      x:Name="BrowseCloneDirectoryButton"
                      Classes="SecondaryAction"
                      Content="{x:Static res:RepositoryManagerStrings.BrowseButton}" />
            </Grid>
          </StackPanel>

          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="10"
                      Margin="0,8,0,0">
            <Button x:Name="CancelCloneButton"
                    Classes="SecondaryAction"
                    Content="{x:Static sharedRes:GlobalStrings.CancelButton}" />
            <Button x:Name="ConfirmCloneButton"
                    Classes="PrimaryAction"
                    Content="{x:Static res:RepositoryManagerStrings.CloneRepositoryButton}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Modal Dialog Overlay: Init -->
    <Border x:Name="InitModalOverlay"
            Background="{DynamicResource ModalOverlayBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsVisible="False">
      <Border Classes="ModalDialogCard"
              Width="520"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <TextBlock Text="{x:Static res:RepositoryManagerStrings.InitModalTitle}"
                     Classes="SectionHeader" />

          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static res:RepositoryManagerStrings.DirectoryLabel}"
                       Classes="SubtleCaption" />
            <Grid ColumnDefinitions="*, 8, Auto">
              <TextBox Grid.Column="0"
                       x:Name="InitDirectoryPathTextBox" />
              <Button Grid.Column="2"
                      x:Name="BrowseInitDirectoryButton"
                      Classes="SecondaryAction"
                      Content="{x:Static res:RepositoryManagerStrings.BrowseButton}" />
            </Grid>
          </StackPanel>

          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="10"
                      Margin="0,8,0,0">
            <Button x:Name="CancelInitButton"
                    Classes="SecondaryAction"
                    Content="{x:Static sharedRes:GlobalStrings.CancelButton}" />
            <Button x:Name="ConfirmInitButton"
                    Classes="PrimaryAction"
                    Content="{x:Static res:RepositoryManagerStrings.InitRepositoryButton}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Operation Running Overlay -->
    <Border x:Name="OperationRunningOverlay"
            Background="{DynamicResource ModalOverlayBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsVisible="False">
      <Border Classes="ModalDialogCard"
              Width="320"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="16" HorizontalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="200" />
          <TextBlock Text="{x:Static res:RepositoryManagerStrings.CloningProgress}"
                     Classes="SubtleCaption"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
    </Border>

    <!-- Modal Dialog Overlay: Settings (Global Settings Only) -->
    <Border x:Name="SettingsModalOverlay"
            Background="{DynamicResource ModalOverlayBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsVisible="False">
      <Border Classes="ModalDialogCard"
              Width="520"
              MaxHeight="620"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="0,0,6,0">
          <StackPanel Spacing="14">
            <TextBlock Text="{x:Static res:RepositoryManagerStrings.SettingsModalTitle}"
                       Classes="SectionHeader" />

            <!-- General Section: Default Projects Directory -->
            <TextBlock Text="{x:Static res:RepositoryManagerStrings.GeneralSettingsSectionTitle}"
                       FontSize="14"
                       FontWeight="SemiBold" />

            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static res:RepositoryManagerStrings.DefaultProjectsDirectoryLabel}"
                         Classes="SubtleCaption" />
              <Grid ColumnDefinitions="*, 8, Auto">
                <TextBox Grid.Column="0"
                         x:Name="DefaultProjectsDirectoryTextBox"
                         Watermark="{x:Static res:RepositoryManagerStrings.DefaultProjectsDirectoryPlaceholder}" />
                <Button Grid.Column="2"
                        x:Name="BrowseDefaultProjectsDirectoryButton"
                        Classes="SecondaryAction"
                        Content="{x:Static res:RepositoryManagerStrings.BrowseButton}" />
              </Grid>
              <TextBlock Text="{x:Static res:RepositoryManagerStrings.DefaultProjectsDirectoryDescription}"
                         Classes="SubtleCaption"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Border Height="1"
                    Background="{DynamicResource CardBorderBrush}"
                    Margin="0,4" />

            <!-- AI Section: Global OpenRouter Configuration -->
            <TextBlock Text="{x:Static res:RepositoryManagerStrings.AiSettingsSectionTitle}"
                       FontSize="14"
                       FontWeight="SemiBold" />

            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static res:RepositoryManagerStrings.AiApiKeyLabel}"
                         Classes="SubtleCaption" />
              <TextBox x:Name="AiApiKeyTextBox"
                       PasswordChar="*"
                       Watermark="{x:Static res:RepositoryManagerStrings.AiApiKeyPlaceholder}" />
            </StackPanel>

            <Grid ColumnDefinitions="*, 110">
              <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,10,0">
                <TextBlock Text="{x:Static res:RepositoryManagerStrings.AiModelLabel}"
                           Classes="SubtleCaption" />
                <TextBox x:Name="AiModelTextBox"
                         Watermark="{x:Static res:RepositoryManagerStrings.AiModelPlaceholder}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="4">
                <TextBlock Text="{x:Static res:RepositoryManagerStrings.AiTokenLimitLabel}"
                           Classes="SubtleCaption" />
                <TextBox x:Name="AiTokenLimitTextBox"
                         Watermark="{x:Static res:RepositoryManagerStrings.AiTokenLimitPlaceholder}" />
              </StackPanel>
            </Grid>

            <StackPanel Spacing="4">
              <TextBlock Text="{x:Static res:RepositoryManagerStrings.AiCommitStyleLabel}"
                         Classes="SubtleCaption" />
              <TextBox x:Name="AiCommitStyleTextBox"
                       Watermark="{x:Static res:RepositoryManagerStrings.AiCommitStylePlaceholder}" />
            </StackPanel>

            <!-- Buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="10"
                        Margin="0,8,0,0">
              <Button x:Name="CancelSettingsButton"
                      Classes="SecondaryAction"
                      Content="{x:Static sharedRes:GlobalStrings.CancelButton}" />
              <Button x:Name="ConfirmSettingsButton"
                      Classes="PrimaryAction"
                      Content="{x:Static sharedRes:GlobalStrings.SaveButton}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Border>

    <!-- Modal Dialog Overlay: Edit Favorite -->
    <Border x:Name="EditFavoriteModalOverlay"
            Background="{DynamicResource ModalOverlayBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsVisible="False">
      <Border Classes="ModalDialogCard"
              Width="480"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <material:MaterialIcon Kind="Star"
                                   Width="24"
                                   Height="24"
                                   Foreground="{DynamicResource WarningBrush}" />
            <TextBlock Text="{x:Static res:RepositoryManagerStrings.EditFavoriteModalTitle}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static res:RepositoryManagerStrings.FavoriteNameLabel}"
                       Classes="FormLabel" />
            <TextBox x:Name="EditFavoriteNameTextBox"
                     Classes="FormInput"
                     Watermark="{x:Static res:RepositoryManagerStrings.FavoriteNamePlaceholder}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Text="{x:Static res:RepositoryManagerStrings.FavoriteGroupLabel}"
                       Classes="FormLabel" />
            <AutoCompleteBox x:Name="EditFavoriteGroupAutoCompleteBox"
                             Classes="FormInput"
                             FilterMode="Contains"
                             MinimumPrefixLength="0"
                             Watermark="{x:Static res:RepositoryManagerStrings.FavoriteGroupPlaceholder}" />
          </StackPanel>

          <StackPanel Spacing="2">
            <TextBlock Text="{x:Static res:RepositoryManagerStrings.DirectoryLabel}"
                       FontSize="11"
                       Classes="SubtleCaption" />
            <TextBlock x:Name="TargetEditFavoritePathTextBlock"
                       Classes="SubtleCaption"
                       TextTrimming="CharacterEllipsis" />
          </StackPanel>

          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="10"
                      Margin="0,8,0,0">
            <Button x:Name="CancelEditFavoriteButton"
                    Classes="SecondaryAction"
                    Content="{x:Static sharedRes:GlobalStrings.CancelButton}" />
            <Button x:Name="ConfirmEditFavoriteButton"
                    Classes="PrimaryAction"
                    Content="{x:Static sharedRes:GlobalStrings.SaveButton}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <!-- Modal Dialog Overlay: Not a Git Repository Init Prompt -->
    <Border x:Name="NotGitRepositoryModalOverlay"
            Background="{DynamicResource ModalOverlayBrush}"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            IsVisible="False">
      <Border Classes="ModalDialogCard"
              Width="480"
              HorizontalAlignment="Center"
              VerticalAlignment="Center">
        <StackPanel Spacing="16">
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <material:MaterialIcon Kind="AlertCircleOutline"
                                   Width="24"
                                   Height="24"
                                   Foreground="{DynamicResource WarningBrush}" />
            <TextBlock Text="{x:Static res:RepositoryManagerStrings.NotGitRepositoryModalTitle}"
                       FontSize="18"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center" />
          </StackPanel>

          <TextBlock Text="{x:Static res:RepositoryManagerStrings.NotGitRepositoryMessage}"
                     Classes="SubtleCaption"
                     TextWrapping="Wrap" />

          <Border Background="{DynamicResource SurfaceCardBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="6"
                  Padding="10,8">
            <TextBlock x:Name="NotGitRepositoryPathTextBlock"
                       Classes="SubtleCaption"
                       TextTrimming="CharacterEllipsis" />
          </Border>

          <TextBlock Text="{x:Static res:RepositoryManagerStrings.NotGitRepositoryQuestion}"
                     FontWeight="SemiBold"
                     TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal"
                      HorizontalAlignment="Right"
                      Spacing="10"
                      Margin="0,8,0,0">
            <Button x:Name="CancelNotGitRepositoryButton"
                    Classes="SecondaryAction"
                    Content="{x:Static sharedRes:GlobalStrings.CancelButton}" />
            <Button x:Name="ConfirmInitNotGitRepositoryButton"
                    Classes="PrimaryAction"
                    Content="{x:Static res:RepositoryManagerStrings.InitializeGitButton}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</rxui:ReactiveUserControl>

<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:material="using:Material.Icons.Avalonia">

  <!-- Action Card Tile in Left Panel -->
  <Style Selector="Border.ActionTile">
    <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="16,14" />
    <Setter Property="Margin" Value="0,4" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.ActionTile:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHighlightBrush}" />
  </Style>

  <!-- Recent Repository Item Card -->
  <Style Selector="Border.RecentRepoCard">
    <Setter Property="Background" Value="{DynamicResource SurfaceCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Margin" Value="0,3" />
    <Setter Property="ClipToBounds" Value="False" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border.RecentRepoCard:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderHighlightBrush}" />
  </Style>

  <!-- Modal Dialog Window Card -->
  <Style Selector="Border.ModalDialogCard">
    <Setter Property="Background" Value="{DynamicResource ModalDialogCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="BoxShadow" Value="0 8 32 0 #50000000" />
    <Setter Property="Padding" Value="24" />
  </Style>

  <!-- Error Banner Card -->
  <Style Selector="Border.ErrorBanner">
    <Setter Property="Background" Value="{DynamicResource ErrorBannerBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,8" />
  </Style>

  <!-- Tab Navigation Buttons in Right Panel -->
  <Style Selector="Button.RepoManagerTab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Foreground" Duration="0:0:0.15" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.RepoManagerTab:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>

  <Style Selector="Button.RepoManagerTab.active">
    <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
  </Style>

  <!-- Group Header Button -->
  <Style Selector="Button.GroupHeaderButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.GroupHeaderButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
  </Style>

  <!-- Group Count Badge -->
  <Style Selector="Border.GroupCountBadge">
    <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="6,2" />
  </Style>

  <!-- Group Item Card -->
  <Style Selector="Border.GroupItemCard">
    <Setter Property="Margin" Value="14,2,0,2" />
  </Style>

  <!-- Repo Select Button inside Card -->
  <Style Selector="Button.RepoSelectButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>

  <!-- Edit Favorite Button -->
  <Style Selector="Button.EditFavoriteButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.EditFavoriteButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceCardHoverBrush}" />
  </Style>

  <Style Selector="Button.EditFavoriteButton:pointerover material|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource GitGraphBranch1Brush}" />
  </Style>

  <!-- Delete Favorite Button -->
  <Style Selector="Button.DeleteFavoriteButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.1" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Button.DeleteFavoriteButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource ErrorBannerBackgroundBrush}" />
  </Style>

  <Style Selector="Button.DeleteFavoriteButton:pointerover material|MaterialIcon">
    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
  </Style>

  <!-- Favorites ScrollViewer -->
  <Style Selector="ScrollViewer.FavoritesScrollViewer">
    <Setter Property="ClipToBounds" Value="False" />
  </Style>

</Styles>
